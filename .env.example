# Server Port (default: 3000)
PORT=3000

# Webhook verification token (you define this in Meta App Dashboard -> WhatsApp -> Configuration)
VERIFY_TOKEN=my_secure_verify_token

# (Optional) Meta App Secret for validating X-Hub-Signature-256 header (from App Dashboard -> App settings -> Basic)
APP_SECRET=your_meta_app_secret_here

# WhatsApp Cloud API Phone Number ID (from WhatsApp -> API Setup)
PHONE_NUMBER_ID=your_phone_number_id_here

# WhatsApp Cloud API System User / Temporary User Access Token (from WhatsApp -> API Setup)
WHATSAPP_TOKEN=your_whatsapp_access_token_here
